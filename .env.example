# ==============================================================================
# EU AI Act Compliance Checker - Environment Variables Template
# ==============================================================================

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Neon Database Connection
DATABASE_URL=postgresql://user:password@ep-something.neon.tech/dbname?sslmode=require

# Better Auth Configuration
BETTER_AUTH_SECRET=generate-a-random-32-character-secret
BETTER_AUTH_URL=https://your-domain.vercel.app

# Resend Transactional Email
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev

# App Configuration
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
REPORT_PRICE_CENTS=2900

# Vercel Blob Storage (Created via Vercel Dashboard -> Storage -> Blob)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Stripe Configuration (Test Mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
